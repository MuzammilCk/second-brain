{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StackInventory",
  "type": "object",
  "required": ["last_updated", "active_focus", "technologies"],
  "properties": {
    "last_updated": { "type": "string", "format": "date-time" },
    "active_focus": {
      "type": "object",
      "required": ["sprint_goal", "started_at"],
      "properties": {
        "sprint_goal": { "type": "string" },
        "started_at": { "type": "string", "format": "date" },
        "target_milestone": { "type": "string" }
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "tier"],
        "properties": {
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["Systems", "AI/ML", "Architecture", "Tooling"],
            "description": "Single source of truth for grouping. compile_progress.py derives the radar quadrant from this — don't also hand-enter a quadrant field, that's how it drifts."
          },
          "tier": { "type": "string", "enum": ["production", "active_sprint", "exploring"] },
          "evidence": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["project_id", "repository", "research_note"] },
              "reference": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "tier": { "enum": ["production", "active_sprint"] } }
            },
            "then": {
              "required": ["evidence"],
              "properties": {
                "evidence": { "required": ["type", "reference"] }
              }
            }
          }
        ]
      }
    }
  }
}
